{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/cloud-hooks/run.sh\" cloud_context_guard.py pre",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/cloud-hooks/run.sh\" cloud_context_guard.py post",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
